[Unit]
Description=HomeOps nightly backup (database + uploaded files)
After=postgresql.service

[Service]
Type=oneshot
User=homeops
Group=homeops
EnvironmentFile=/etc/homeops/homeops.env
ExecStart=/opt/homeops/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/homeops/backups
