# Copy to .env and fill in. Never commit .env.

# The public address, exactly as you open it in the browser. Passkeys and push
# notifications are bound to this origin.
HOMEOPS_PUBLIC_URL=https://home.example.com

# Contact address sent to browser push services (required by the Web Push spec).
HOMEOPS_VAPID_EMAIL=you@example.com

# Database password. Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Object storage (SeaweedFS) keys for uploads. Generate each with:  openssl rand -hex 20
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker).
TUNNEL_TOKEN=

# Optional
# HOMEOPS_LOCAL_PORT=8080    # LAN-only port on the server (127.0.0.1)
# BACKUP_AT=02:30            # nightly backup time, local
# BACKUP_KEEP_DAYS=30
# TZ=Asia/Kolkata
